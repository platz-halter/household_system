# Copy to .env and fill in real values. .env is gitignored.

# --- Postgres ---
POSTGRES_USER=hs_admin
POSTGRES_PASSWORD=changeme

# --- Auth mode ---
# "authentik" in normal use; "local" for offline dev via the auth service's /token endpoint.
AUTH_MODE=authentik

# --- Authentik OIDC (only needed when AUTH_MODE=authentik) ---
AUTHENTIK_ISSUER=https://authentik.pressnet.duckdns.org/application/o/household-system/
AUTHENTIK_JWKS_URL=https://authentik.pressnet.duckdns.org/application/o/household-system/jwks/
AUTHENTIK_CLIENT_ID=

# --- Local fallback auth (only needed when AUTH_MODE=local) ---
LOCAL_JWT_SECRET=dev-only-change-me
LOCAL_JWT_ALGORITHM=HS256

ENVIRONMENT=dev
