# Household System V2 — environment configuration
#
# Copy this file to `.env` (same directory as docker-compose.yml) and fill
# in real values. Both the Authentik and local-account auth paths are
# always active at once — there is no AUTH_MODE switch. Local accounts
# are the always-on fallback if Authentik is unreachable.

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------

POSTGRES_USER=household
# Use an alphanumeric-only password — ':', '/', '#', '@' etc. break DSN
# parsing in the services' DATABASE_URL construction.
POSTGRES_PASSWORD=changeme123
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Per-service databases (all live in the one Postgres container)
AUTH_DB_NAME=household_auth
STORAGE_DB_NAME=household_storage
HOUSEHOLD_DB_NAME=household_household

# ---------------------------------------------------------------------------
# Auth — both paths are always active
# ---------------------------------------------------------------------------

ENVIRONMENT=production

# auth service's own base URL, used by other services if they need to
# reach it directly
AUTH_SERVICE_URL=http://auth:8000

# Comma-separated list of allowed CORS origins, or "*" for all
CORS_ORIGINS=https://household.example.com

# ---------------------------------------------------------------------------
# Authentik OIDC (primary auth)
# ---------------------------------------------------------------------------

# Issuer URL of your Authentik application, e.g.
# https://authentik.example.com/application/o/household-system/
AUTHENTIK_ISSUER=https://authentik.example.com/application/o/household-system/

# JWKS endpoint used by the backends to verify Authentik-issued (RS256)
# tokens
AUTHENTIK_JWKS_URL=https://authentik.example.com/application/o/household-system/jwks/

# Public SPA client ID (no client secret — PKCE, Authorization Code flow)
AUTHENTIK_CLIENT_ID=household-system

# Used by the frontend to build the OIDC Authorization Code + PKCE flow.
# AUTHENTIK_REDIRECT_URI is computed client-side from window.location.origin
# and does not need to be set here; it's listed for reference.
AUTHENTIK_AUTHORIZE_URL=https://authentik.example.com/application/o/authorize/
AUTHENTIK_TOKEN_URL=https://authentik.example.com/application/o/token/
AUTHENTIK_END_SESSION_URL=https://authentik.example.com/application/o/household-system/end-session/
AUTHENTIK_SCOPE="openid profile email groups"

# Authentik groups mapped to roles (fixed names expected by shared/auth.py;
# listed here for reference, not meant to be overridden via env)
# household-system-admins  -> admin
# household-system-users   -> user
# household-system-viewers -> viewer
# Any other/missing group fails closed to "viewer".

# ---------------------------------------------------------------------------
# Local fallback auth
# ---------------------------------------------------------------------------

# Secret used to sign/verify locally-issued (HS256) JWTs. Generate with:
#   openssl rand -hex 32
LOCAL_JWT_SECRET=changeme-generate-a-real-secret
LOCAL_JWT_ALGORITHM=HS256
LOCAL_JWT_EXPIRE_MINUTES=60

# Bootstrap credentials for the first local admin account (used once by
# the auth service's bootstrap endpoint; change/remove after first use)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=changeme123

# ---------------------------------------------------------------------------
# Web Push (household service only) — todo-board "requested from you"
# notifications and admin-triggered weekly reminders.
# ---------------------------------------------------------------------------

# Generate a real pair with:
#   uv run --package household-backend python household/backend/scripts/generate_vapid_keys.py
# VAPID_PUBLIC_KEY is not secret (handed to every browser); VAPID_PRIVATE_KEY is.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address push services may use if something's wrong with your
# server's requests — any mailto: or https: URL works.
VAPID_SUBJECT=mailto:admin@example.com

